{
  "name": "@Kakoolnews Telegram Proxy",
  "build": {
    "dockerfile": "./Dockerfile",
    "context": "."
  },
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "chmod +x /usr/local/bin/entrypoint.sh",
  "postAttachCommand": "/usr/local/bin/entrypoint.sh",
  "portsAttributes": {
    "443": {
      "label": "mtproto-proxy",
      "protocol": "http",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [443],
  "hostRequirements": {
    "cpus": 2
  }
}
