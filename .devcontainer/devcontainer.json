{
  "name": "@KakoolNews Telegram Proxy",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false
    },
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "postCreateCommand": "apt-get update && apt-get install -y python3 python3-pip && pip3 install mtprotoproxy && chmod +x /workspaces/telegram-kakoolnews/.devcontainer/entrypoint.sh",
  "postAttachCommand": "/bin/bash /workspaces/telegram-kakoolnews/.devcontainer/entrypoint.sh",
  "portsAttributes": {
    "3128": {
      "label": "telegram-proxy",
      "protocol": "tcp",
      "onAutoForward": "silent"
    }
  },
  "forwardPorts": [3128],
  "hostRequirements": {
    "cpus": 1
  }
}
